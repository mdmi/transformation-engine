<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:dfdl="http://www.ogf.org/dfdl/dfdl-1.0/"
	xmlns:ibmEdiFmt="http://www.ibm.com/dfdl/EDI/Format"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<xsd:import namespace="http://www.ibm.com/dfdl/EDI/Format"
		schemaLocation="/EDIFACT-Common/IBM_EDI_Format.dfdl.xsd" />
	<xsd:annotation>
		<xsd:appinfo source="http://www.ogf.org/dfdl/">
			<dfdl:format ref="ibmEdiFmt:EDIFormat"
				escapeSchemeRef="EDIEscapeScheme" />
			<dfdl:defineEscapeScheme
				name="EDIEscapeScheme">
				<dfdl:escapeScheme escapeKind="escapeCharacter"
					escapeCharacter="{$ibmEdiFmt:EscapeChar}"
					escapeEscapeCharacter="{$ibmEdiFmt:EscapeChar}"
					extraEscapedCharacters="*" />
			</dfdl:defineEscapeScheme>
		</xsd:appinfo>
	</xsd:annotation>


	<xsd:complexType name="Loop2010Type">
		<xsd:sequence>

			<!-- NM1 – Event Provider -->
			<xsd:element name="NM1" type="NM1Type"
				dfdl:initiator="NM1" dfdl:ref="ibmEdiFmt:EDISegmentFormat">
				<!-- <xsd:annotation> <xsd:appinfo source="http://www.ogf.org/dfdl/dfdl-1.0/"> 
					<dfdl:discriminator test="{NM101 = 'EV'}"/> </xsd:appinfo> </xsd:annotation> -->
			</xsd:element>

			<!-- N3 – Address -->
			<xsd:element name="N3" type="N3Type" minOccurs="0"
				dfdl:initiator="N3" dfdl:ref="ibmEdiFmt:EDISegmentFormat" />

			<!-- N4 – City/State/ZIP -->
			<xsd:element name="N4" type="N4Type" minOccurs="0"
				dfdl:initiator="N4" dfdl:ref="ibmEdiFmt:EDISegmentFormat" />



			<!-- REF – Identifiers -->
			<xsd:element name="REF" type="REFType" minOccurs="0"
				maxOccurs="99" dfdl:initiator="REF"
				dfdl:ref="ibmEdiFmt:EDISegmentFormat" />

			<!-- PER – Contact -->
			<xsd:element name="PER" type="PERType" minOccurs="0"
				maxOccurs="99" dfdl:initiator="PER"
				dfdl:ref="ibmEdiFmt:EDISegmentFormat" />

			<!-- PRV – Provider Specialty -->
			<xsd:element name="PRV" type="PRVType" minOccurs="0"
				dfdl:initiator="PRV" dfdl:ref="ibmEdiFmt:EDISegmentFormat" />

		</xsd:sequence>
	</xsd:complexType>



